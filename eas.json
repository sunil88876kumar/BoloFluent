{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.22.3",
      "env": {
        "BOLO_DEV_NETWORK": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "node": "24.22.3",
      "env": {
        "BOLO_DEV_NETWORK": "0"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
