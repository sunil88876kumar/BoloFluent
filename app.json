{
  "expo": {
    "name": "BoloFluent",
    "slug": "bolofluent",
    "version": "0.1.0",
    "scheme": "bolofluent",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bolofluent.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.bolofluent.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "BoloFluent"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BoloFluent to record your voice for private, on-device speaking practice.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-offline-models.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5b80f387-9a03-4f59-bbe4-9b5bb6ea36a8"
      }
    }
  }
}
